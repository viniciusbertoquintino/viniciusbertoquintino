# ─── Frontend (Vite) — obrigatório para a interface ─────────────────────────
# Depois de `supabase start`, copie API URL e anon key de `supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# ─── Edge Functions locais ──────────────────────────────────────────────────
# A mesma chave vai em supabase/functions/.env (veja supabase/functions/.env.example).
# Chat e agentes leem OPENAI_API_KEY nesse arquivo, não a chave salva em Configurações.
OPENAI_API_KEY=

# ─── Backend FastAPI opcional (a interface não usa) ─────────────────────────
DATABASE_URL=postgresql+asyncpg://aiplatform:aiplatform@localhost:5432/ai_platform
SECRET_KEY=change-me-in-production
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=4
